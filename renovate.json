{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "14 days",
  "julia": {
    "ignorePaths": [
      "**/{node_modules,bower_components,vendor,examples,__tests__,tests,__fixtures__}/**",
      "**/test/*/**"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Formatter and linter versions pinned at their call site. Each pin carries a `# renovate:` comment naming its datasource, so the same manager handles the shell script and the workflow.",
      "managerFilePatterns": [
        "/^scripts/format\\.sh$/",
        "/^\\.github/workflows/CI\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[^\\n]*?@(?<currentValue>\\d[^\\s\"']+)",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[^\\n]*?version=?:? ?\"(?<currentValue>\\d[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Track only the solver pins in the test project.",
      "matchManagers": ["julia"],
      "matchFileNames": ["test/Project.toml"],
      "enabled": false
    },
    {
      "description": "Review changes to the Julia wrapper and native solver together across the shared workspace.",
      "matchManagers": ["julia"],
      "matchFileNames": ["test/Project.toml", "benchmarks/Project.toml"],
      "matchDepNames": ["HiGHS", "HiGHS_jll"],
      "groupName": "HiGHS solver",
      "enabled": true,
      "automerge": false
    },
    {
      "description": "JuliaFormatter has no Renovate datasource for the Julia General registry, so it is tracked by GitHub tag, which carries a leading `v`.",
      "matchDepNames": ["JuliaEditorSupport/JuliaFormatter.jl"],
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "description": "Track Ruff tool pins together through the custom manager.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/CI.yml"],
      "matchDepTypes": ["uses-with"],
      "matchDepNames": ["ruff"],
      "enabled": false
    },
    {
      "description": "Batch mature formatter patches once a week. Both formatter jobs are required on master.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["ruff", "JuliaEditorSupport/JuliaFormatter.jl"],
      "matchUpdateTypes": ["patch"],
      "groupName": "formatter patches",
      "timezone": "America/Los_Angeles",
      "schedule": ["* * * * 1"],
      "automergeSchedule": ["* * * * 1"],
      "platformAutomerge": false,
      "automerge": true
    },
    {
      "description": "Auto-merge uv tool patches after the required benchmark analysis tests pass.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/CI.yml"],
      "matchDepTypes": ["uses-with"],
      "matchPackageNames": ["astral-sh/uv"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ]
}
